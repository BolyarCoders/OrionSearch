{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orion:research:provisional:v1:result",
  "title": "Provisional research result — pending ORION-8 agreement",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "orion.research.provisional.v1"
    },
    "researchRunId": {
      "type": "string",
      "format": "uuid"
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      },
      "maxItems": 256
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 256
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 256
    }
  },
  "required": [
    "contractVersion",
    "researchRunId",
    "queries",
    "sources",
    "findings"
  ],
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "query",
        "provider"
      ]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        }
      },
      "required": [
        "name",
        "domain"
      ]
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "storageUri",
        "sha256"
      ]
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "startOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "endOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tokenCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "index",
        "text"
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fetchedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "extractedText": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "anyOf": [
            {
              "$ref": "#/$defs/raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "chunks": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/chunk"
              },
              "maxItems": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "fetchedAt"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "canonicalUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2,
              "pattern": "^[A-Za-z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher": {
          "anyOf": [
            {
              "$ref": "#/$defs/publisher"
            },
            {
              "type": "null"
            }
          ]
        },
        "relevance": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "capture": {
          "anyOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "canonicalUrl"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "stance": {
          "enum": [
            "supports",
            "contradicts",
            "mentions"
          ]
        },
        "chunkIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sourceKey",
        "stance"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "type": {
          "enum": [
            "claim",
            "observation",
            "estimate"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 100
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "statement",
        "type",
        "evidence"
      ]
    }
  }
}
